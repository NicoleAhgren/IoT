        "type": "function",
        "z": "35fe950efef4834d",
        "name": "Formatera historik",
        "func": "if (!msg.payload || msg.payload.length === 0 || !msg.payload[0].value) {\n    return null;\n}\n\nmsg.payload = [{\n    \"series\": [\"Temperatur\"],\n    \"data\": [msg.payload.map(function(row) {\n        return { x: row.timestamp, y: row.value };\n    })],\n    \"labels\": [\"\"]\n}];\nreturn msg;\n",
